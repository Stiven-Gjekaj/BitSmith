.pnp
.pnp.*

# Build output
dist/
.astro/
.output/
.vercel/
.netlify/

# Environment files
# These files hold secrets.
# Never commit them.
# Commit .env.example instead, and put no real value in it.
.env
.env.local
.env.*.local
!.env.example

# Test output
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Cloudflare
.wrangler/
.dev.vars

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Desktop.ini

# Claude Code
# This block hides the personal files and keeps the shared ones.
# Keep settings.json in the repository.
# It holds the commit attribution rule that AGENTS.md demands.
# That rule must travel with the repository, and not stay on one machine.
# The AGENTS.md section "What to keep" gives this reason.
.claude/*
!.claude/settings.json

# Add a line like the next one when you create a shared directory.
# !.claude/commands/

# Machine learning models
#
# The rule is to keep a model out of git, because a model file is often tens of
# megabytes and git keeps every version of it forever.
#
# u2netp.onnx is the exception, and it is committed on purpose. It is 4.5 MB,
# which is small enough that the repository does not suffer, and committing it
# is what lets the site serve the model from its own address. Section 6 of
# docs/plan.md refuses to load a model from a third party at run time, because
# the site must keep working when that third party does not.
#
# Keep this exception narrow. A larger model belongs in object storage.
public/models/*
!public/models/u2netp.onnx

# Copied from node_modules by scripts/copy-ort.mjs on every build.
public/ort/
