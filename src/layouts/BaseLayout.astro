---
import Backdrop from "../components/ui/Backdrop.astro";
import Logo from "../components/ui/Logo.astro";
import { href } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Structured data for a search engine. Built from the registry. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" rx="22" fill="#04060c"/><g transform="translate(12 13) scale(3)" fill="none" stroke="#38e8ff" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10H6a4 4 0 0 1-4-4 1 1 0 0 1 1-1h4"/><path d="M7 5a1 1 0 0 1 1-1h13a1 1 0 0 1 1 1 7 7 0 0 1-7 7H8a1 1 0 0 1-1-1z"/><path d="M9 12v5"/><path d="M15 12v5"/><path d="M5 20a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3 1 1 0 0 1-1 1H6a1 1 0 0 1-1-1"/></g></svg>`,
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    <meta name="theme-color" content="#04060c" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {
      jsonLd ? (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      ) : null
    }
  </head>

  <body>
    <Backdrop />

    <a href="#main" class="skip">Skip to the content</a>

    <header class="shell head">
      <a href={href()} class="brand">
        <Logo />
        <span>Bitsmith</span>
      </a>
      <nav class="nav">
        <a href={href()}>Tools</a>
        <a href="https://github.com/Stiven-Gjekaj/bitsmith">Source</a>
      </nav>
    </header>

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="shell foot">
      <p class="tag">Bitsmith</p>
      <p class="foot-line">
        Every tool runs on your own device. No file is uploaded, because there
        is no server to upload it to.
      </p>
      <p class="foot-links">
        <a href={href()}>Home</a>
        <span aria-hidden="true">/</span>
        <a href="https://github.com/Stiven-Gjekaj/bitsmith">Source</a>
        <span aria-hidden="true">/</span>
        <a href="https://github.com/Stiven-Gjekaj/bitsmith/blob/main/LICENSE"
          >MIT</a
        >
      </p>
    </footer>

  </body>
</html>

<style is:global>
  .shell {
    width: 100%;
    max-width: 62rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 50;
    background: var(--glow);
    color: var(--void);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 600;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.15rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 1.35rem;
    font-size: 0.9rem;
  }
  .nav a {
    color: var(--mist);
    text-decoration: none;
    position: relative;
    transition: color 0.25s ease;
  }
  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--glow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav a:hover::after {
    transform: scaleX(1);
  }

  main {
    padding-block: 2.5rem 5rem;
    min-height: 60vh;
  }

  .foot {
    border-top: 1px solid var(--line);
    padding-block: 2.25rem 3rem;
    color: var(--mist);
    font-size: 0.9rem;
  }
  .foot-line {
    margin-top: 0.5rem;
    max-width: 42rem;
  }
  .foot-links {
    margin-top: 0.9rem;
    display: flex;
    gap: 0.7rem;
    align-items: center;
  }
  .foot-links a {
    color: var(--mist);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .foot-links a:hover {
    color: var(--glow);
  }
  .foot-links span {
    opacity: 0.4;
  }

</style>
