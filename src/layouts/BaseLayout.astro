---
import Analytics from "../components/ui/Analytics.astro";
import Backdrop from "../components/ui/Backdrop.astro";
import Logo from "../components/ui/Logo.astro";
import { href } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Structured data for a search engine. Built from the registry. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const link =
  "text-muted-foreground no-underline transition-colors hover:text-primary";

const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" rx="22" fill="#04060c"/><g transform="translate(12 13) scale(3)" fill="none" stroke="#38e8ff" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10H6a4 4 0 0 1-4-4 1 1 0 0 1 1-1h4"/><path d="M7 5a1 1 0 0 1 1-1h13a1 1 0 0 1 1 1 7 7 0 0 1-7 7H8a1 1 0 0 1-1-1z"/><path d="M9 12v5"/><path d="M15 12v5"/><path d="M5 20a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3 1 1 0 0 1-1 1H6a1 1 0 0 1-1-1"/></g></svg>`,
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    <meta name="theme-color" content="#04060c" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    {
      jsonLd ? (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      ) : null
    }

    <Analytics />
  </head>

  <body class="min-h-screen">
    <Backdrop />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-primary-foreground"
    >
      Skip to the content
    </a>

    <header
      class="mx-auto flex w-full max-w-4xl items-center justify-between px-5 py-4"
    >
      <a
        href={href()}
        class="inline-flex items-center gap-2.5 font-semibold tracking-tight text-foreground no-underline"
      >
        <Logo />
        <span>Bitsmith</span>
      </a>
      <nav class="flex gap-6 text-sm">
        <a href={href()} class={link}>Tools</a>
        <a href="https://github.com/Stiven-Gjekaj/bitsmith" class={link}>
          Source
        </a>
      </nav>
    </header>

    <main id="main" class="mx-auto w-full max-w-4xl px-5 pt-8 pb-20">
      <slot />
    </main>

    <footer class="mt-12 border-t border-border py-9 text-sm">
      <div class="mx-auto w-full max-w-4xl px-5">
        <p class="tag">Bitsmith</p>
        <p class="mt-2 max-w-2xl text-muted-foreground">
          Every tool runs on your own device. No file is uploaded, because there
          is no server to upload it to.
        </p>
        <p class="mt-3 flex items-center gap-2.5 text-muted-foreground">
          <a href={href()} class={link}>Home</a>
          <span aria-hidden="true" class="opacity-40">/</span>
          <a href="https://github.com/Stiven-Gjekaj/bitsmith" class={link}>
            Source
          </a>
          <span aria-hidden="true" class="opacity-40">/</span>
          <a
            href="https://github.com/Stiven-Gjekaj/bitsmith/blob/main/LICENSE"
            class={link}>MIT</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
