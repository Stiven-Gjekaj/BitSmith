---
import { href } from "../../lib/url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { otherTools, type ToolMeta } from "../../tools/registry";
import ToolRunner from "../shell/ToolRunner";
import ToolIcon from "../ui/ToolIcon.astro";

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const related = otherTools(tool.slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.title,
  description: tool.description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any browser",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const onDevice = tool.runsOn === "device";
---

<BaseLayout
  title={`${tool.title} | Bitsmith`}
  description={tool.description}
  jsonLd={jsonLd}
>
  <a
    href={href()}
    class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground no-underline transition-colors hover:text-primary"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">
      <path d="M19 12H5M11 18l-6-6 6-6"></path>
    </svg>
    All tools
  </a>

  <header class="rise mt-6 flex items-start gap-4">
    <span
      class="grid size-12 shrink-0 place-items-center rounded-lg border border-border bg-primary/5 text-primary"
    >
      <ToolIcon slug={tool.slug} size={26} />
    </span>
    <div>
      <h1 class="text-3xl leading-tight font-bold tracking-tighter sm:text-4xl">
        {tool.title}
      </h1>
      <p class="mt-1.5 text-lg text-muted-foreground">{tool.tagline}</p>
    </div>
  </header>

  <p
    class:list={[
      "rise mt-5 inline-flex w-fit items-center gap-2 rounded-full border px-3 py-1 text-sm",
      onDevice
        ? "border-success/30 bg-success/10 text-success"
        : "border-warning/30 bg-warning/10 text-warning",
    ]}
    style="animation-delay:120ms"
  >
    <span
      class:list={[
        "size-1.5 rounded-full",
        onDevice ? "bg-success" : "bg-warning",
      ]}
      style="animation:breathe 2.6s ease-in-out infinite"
      aria-hidden="true"></span>
    {
      onDevice
        ? "This file stays on your device"
        : "This tool sends your file to a server"
    }
  </p>

  <div
    class="rise mt-7 rounded-lg border border-border bg-card/80 p-6 backdrop-blur-sm"
    style="animation-delay:200ms"
  >
    <ToolRunner client:load slug={tool.slug} />
  </div>

  <section class="rise mt-14 border-t border-border pt-8" style="animation-delay:300ms">
    <h2 class="tag">About this tool</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      {tool.description}
    </p>
  </section>

  <section class="rise mt-12" style="animation-delay:380ms">
    <h2 class="tag">Other tools</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        related.map((other) => (
          <a
            class="sweep group relative flex items-center gap-3.5 overflow-hidden rounded-lg border border-border bg-card/70 px-4 py-3.5 no-underline transition-all hover:-translate-y-0.5 hover:border-ring"
            href={href(other.slug)}
          >
            <span class="grid size-8 shrink-0 place-items-center rounded-md border border-border text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-primary">
              <ToolIcon slug={other.slug} size={18} />
            </span>
            <span>
              <span class="block text-sm font-medium text-foreground">
                {other.title}
              </span>
              <span class="block text-sm text-muted-foreground">
                {other.tagline}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
