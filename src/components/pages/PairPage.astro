---
import { href } from "../../lib/url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EXTENSION, MIME } from "../../lib/image/codecs";
import { type Pair, relatedPairs } from "../../tools/image-convert/pairs";
import ToolRunner from "../shell/ToolRunner";
import ToolIcon from "../ui/ToolIcon.astro";

interface Props {
  pair: Pair;
}

const { pair } = Astro.props;
const related = relatedPairs(pair);

const title = `Convert ${pair.fromLabel} to ${pair.toLabel}`;
const description =
  `Turn a ${pair.fromLabel} into a ${pair.toLabel} in your browser. ` +
  `${pair.tagline} No upload, no account, and the file never leaves your ` +
  `device.`;

// Two kinds of structured data, because the page is two things. It is a tool
// a person can use, and it is an answer to three questions they were about to
// ask. The questions are the ones the writing below already answers, so the
// data and the page cannot drift apart.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: title,
      description,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Any browser",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: `Why convert ${pair.fromLabel} to ${pair.toLabel}?`,
          acceptedAnswer: { "@type": "Answer", text: pair.why },
        },
        {
          "@type": "Question",
          name: `What is lost converting ${pair.fromLabel} to ${pair.toLabel}?`,
          acceptedAnswer: { "@type": "Answer", text: pair.cost },
        },
        {
          "@type": "Question",
          name: `When should I not convert ${pair.fromLabel} to ${pair.toLabel}?`,
          acceptedAnswer: { "@type": "Answer", text: pair.caution },
        },
      ],
    },
  ],
};
---

<BaseLayout title={`${title} | Bitsmith`} description={description} jsonLd={jsonLd}>
  <a
    href={href()}
    class="group inline-flex items-center gap-1.5 text-sm text-muted-foreground no-underline transition-colors hover:text-primary"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">
      <path d="M19 12H5M11 18l-6-6 6-6"></path>
    </svg>
    All tools
  </a>

  <header class="rise mt-6 flex items-start gap-4">
    <span class="grid size-12 shrink-0 place-items-center rounded-lg border border-border bg-primary/5 text-primary">
      <ToolIcon slug="image-converter" size={26} />
    </span>
    <div>
      <h1 class="text-3xl leading-tight font-bold tracking-tighter sm:text-4xl">
        {title}
      </h1>
      <p class="mt-1.5 text-lg text-muted-foreground">{pair.tagline}</p>
    </div>
  </header>

  <p
    class="rise mt-5 inline-flex w-fit items-center gap-2 rounded-full border border-success/30 bg-success/10 px-3 py-1 text-sm text-success"
    style="animation-delay:120ms"
  >
    <span class="size-1.5 rounded-full bg-success" style="animation:breathe 2.6s ease-in-out infinite" aria-hidden="true"></span>
    This file stays on your device
  </p>

  <div
    class="rise mt-7 rounded-lg border border-border bg-card/80 p-6 backdrop-blur-sm"
    style="animation-delay:200ms"
  >
    <ToolRunner
      client:load
      slug="image-converter"
      preset={{ format: pair.to, accept: MIME[pair.from] }}
    />
  </div>

  <section class="notes rise mt-14 grid gap-8 border-t border-border pt-8 sm:grid-cols-2" style="animation-delay:300ms">
    <article>
      <h2 class="text-base font-semibold tracking-tight">
        Why turn a {pair.fromLabel} into a {pair.toLabel}
      </h2>
      <p class="mt-2.5 max-w-xl leading-relaxed text-muted-foreground">{pair.why}</p>
    </article>

    <article>
      <h2 class="text-base font-semibold tracking-tight">What the change costs</h2>
      <p class="mt-2.5 max-w-xl leading-relaxed text-muted-foreground">{pair.cost}</p>
    </article>

    <article>
      <h2 class="text-base font-semibold tracking-tight">When to do something else</h2>
      <p class="mt-2.5 max-w-xl leading-relaxed text-muted-foreground">{pair.caution}</p>
    </article>
  </section>

  <section class="rise mt-12" style="animation-delay:380ms">
    <h2 class="tag">Other conversions</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {
        related.map((other) => (
          <a
            class="sweep group relative flex items-center gap-3.5 overflow-hidden rounded-lg border border-border bg-card/70 px-4 py-3.5 no-underline transition-all hover:-translate-y-0.5 hover:border-ring"
            href={href(other.slug)}
          >
            <span class="grid size-8 shrink-0 place-items-center rounded-md border border-border text-muted-foreground transition-colors group-hover:border-primary/40 group-hover:text-primary">
              <ToolIcon slug="image-converter" size={18} />
            </span>
            <span>
              <span class="block text-sm font-medium text-foreground">
                {other.fromLabel} to {other.toLabel}
              </span>
              <span class="block text-sm text-muted-foreground">{other.tagline}</span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="mt-5 text-sm">
      <a
        href={href("image-converter")}
        class="text-muted-foreground underline underline-offset-4 hover:text-primary"
      >
        Or use the converter with every format at once
      </a>
    </p>
  </section>
</BaseLayout>
