---
/**
 * The background.
 *
 * Three layers, and none of them takes a pointer event:
 *   1. Two slow gradient orbs that drift.
 *   2. A fine grid that fades out towards the edges.
 *   3. A spotlight that follows the pointer.
 *
 * The first two are CSS. The third needs the pointer position, so a small
 * script writes it into two custom properties and the styles read them. That
 * script does no layout work and no paint work of its own.
 */
---

<div class="backdrop" aria-hidden="true">
  <div class="orb orb-a"></div>
  <div class="orb orb-b"></div>
  <div class="grid"></div>
  <div class="spotlight"></div>
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--void);
  }

  .orb {
    position: absolute;
    width: 46rem;
    height: 46rem;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    will-change: transform;
  }

  .orb-a {
    top: -18rem;
    left: -12rem;
    background: radial-gradient(circle, var(--glow) 0%, transparent 65%);
    animation: drift 26s ease-in-out infinite;
  }

  .orb-b {
    right: -16rem;
    bottom: -20rem;
    background: radial-gradient(circle, var(--pulse) 0%, transparent 65%);
    animation: drift 34s ease-in-out infinite reverse;
  }

  /* The grid gives the page a sense of a surface. It is masked so that it
     never reaches an edge, which keeps it from reading as a table. */
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 90% 60% at 50% 0%, #000 20%, transparent 78%);
  }

  /* Follows the pointer. The two properties come from the script below, and
     they start in the middle so the page looks right before a pointer moves.
     A touch screen never fires the event, and the default is what it keeps. */
  .spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      36rem 36rem at var(--px, 50%) var(--py, 30%),
      var(--glow-soft) 0%,
      transparent 60%
    );
    transition: opacity 0.5s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .orb {
      animation: none;
    }
  }
</style>

<script>
  // Writing to a custom property lets the compositor do the work. Setting a
  // background position directly would repaint the whole layer on every move.
  let frame = 0;

  addEventListener(
    "pointermove",
    (event: PointerEvent) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const root = document.documentElement;
        root.style.setProperty("--px", `${event.clientX}px`);
        root.style.setProperty("--py", `${event.clientY}px`);
      });
    },
    { passive: true },
  );
</script>
