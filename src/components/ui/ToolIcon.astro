---
/**
 * One line drawing for each tool.
 *
 * These are written here rather than pulled from an icon set. A handful of
 * icons is less code than a dependency, and each one inherits the accent
 * colour and the stroke weight of the design instead of bringing its own.
 */
interface Props {
  slug: string;
  size?: number;
}
const { slug, size = 22 } = Astro.props;

const paths: Record<string, string[]> = {
  "qr-code-generator": [
    "M4 4h6v6H4z",
    "M14 4h6v6h-6z",
    "M4 14h6v6H4z",
    "M14 14h2v2h-2z",
    "M18 18h2v2h-2z",
    "M14 20h2",
  ],
  "image-converter": [
    "M4 7a2 2 0 0 1 2-2h7l3 3h2a2 2 0 0 1 2 2v2",
    "M20 13v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7",
    "M9 15l2.5-3 2 2.5L15.5 12l3.5 4",
  ],
  "strip-metadata": [
    "M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z",
    "M4 15l4-4 3 3 3-3 4 4",
    "M9 9.5a1 1 0 1 0 0-.01",
    "M3 3l18 18",
  ],
  "rotate-image": [
    "M4 12a8 8 0 0 1 13.7-5.7L20 8.5",
    "M20 4v4.5h-4.5",
    "M20 12a8 8 0 0 1-13.7 5.7L4 15.5",
    "M4 20v-4.5h4.5",
  ],
  "crop-image": ["M7 3v14h14", "M3 7h14v14", "M17 7h4", "M7 17v4"],
  "merge-pdf": [
    "M8 3h6l4 4v9a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z",
    "M14 3v4h4",
    "M4 9v10a2 2 0 0 0 2 2h9",
  ],
  "remove-background": [
    "M4 4h5M15 4h5M4 20h5M15 20h5M4 9v6M20 9v6",
    "M9 15l2.5-3.5L14 15l1.5-2 2 3z",
    "M10 9.5a1 1 0 1 0 0-.01",
  ],
};

const shape = paths[slug];

// A missing icon used to fall back to a single dash. That is the worst kind
// of failure: the page still builds, the card still renders, and the tool
// merely looks slightly wrong to anybody who never saw the others. Stopping
// the build is louder and cheaper.
if (!shape) {
  throw new Error(
    `No icon for the tool "${slug}". Add its paths to ToolIcon.astro.`,
  );
}
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {shape.map((d) => <path d={d}></path>)}
</svg>
