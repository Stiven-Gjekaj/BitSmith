---
/**
 * One line drawing for each tool.
 *
 * These are written here rather than pulled from an icon set. Five icons is
 * less code than a dependency, and each one inherits the accent colour and the
 * stroke weight of the design instead of bringing its own.
 */
interface Props {
  slug: string;
  size?: number;
}
const { slug, size = 22 } = Astro.props;

const paths: Record<string, string[]> = {
  "qr-code-generator": [
    "M4 4h6v6H4z",
    "M14 4h6v6h-6z",
    "M4 14h6v6H4z",
    "M14 14h2v2h-2z",
    "M18 18h2v2h-2z",
    "M14 20h2",
  ],
  "image-converter": [
    "M4 7a2 2 0 0 1 2-2h7l3 3h2a2 2 0 0 1 2 2v2",
    "M20 13v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7",
    "M9 15l2.5-3 2 2.5L15.5 12l3.5 4",
  ],
  "crop-image": ["M7 3v14h14", "M3 7h14v14", "M17 7h4", "M7 17v4"],
  "merge-pdf": [
    "M8 3h6l4 4v9a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z",
    "M14 3v4h4",
    "M4 9v10a2 2 0 0 0 2 2h9",
  ],
  "remove-background": [
    "M4 4h5M15 4h5M4 20h5M15 20h5M4 9v6M20 9v6",
    "M9 15l2.5-3.5L14 15l1.5-2 2 3z",
    "M10 9.5a1 1 0 1 0 0-.01",
  ],
};

const shape = paths[slug] ?? ["M5 12h14"];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {shape.map((d) => <path d={d}></path>)}
</svg>
