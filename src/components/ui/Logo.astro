---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

{/*
  The anvil is the "anvil" icon from Lucide (https://lucide.dev), under the ISC
  licence, copyright Lucide Icons and Contributors. The licence text is in
  LICENSES/lucide.txt. It is drawn rather than fetched, so it costs no request
  and it takes the accent colour of the page it sits on.
*/}
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="url(#markSpark)"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label="Bitsmith"
  class="logo"
>
  <defs>
    <linearGradient id="markSpark" x1="2" y1="4" x2="22" y2="21">
      <stop offset="0" stop-color="var(--glow)"></stop>
      <stop offset="1" stop-color="var(--pulse)"></stop>
    </linearGradient>
  </defs>
  <path d="M7 10H6a4 4 0 0 1-4-4 1 1 0 0 1 1-1h4"></path>
  <path d="M7 5a1 1 0 0 1 1-1h13a1 1 0 0 1 1 1 7 7 0 0 1-7 7H8a1 1 0 0 1-1-1z"
  ></path>
  <path d="M9 12v5"></path>
  <path d="M15 12v5"></path>
  <path d="M5 20a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3 1 1 0 0 1-1 1H6a1 1 0 0 1-1-1"
  ></path>
</svg>

<style>
  .logo {
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }
  a:hover .logo {
    opacity: 1;
  }
</style>
