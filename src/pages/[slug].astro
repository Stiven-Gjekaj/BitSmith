---
import ToolRunner from "../components/shell/ToolRunner";
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/url";
import { otherTools, type ToolMeta, tools } from "../tools/registry";

export function getStaticPaths() {
  // One entry in the registry becomes one page. Adding a tool needs no change
  // to this file.
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
const related = otherTools(tool.slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: tool.title,
  description: tool.description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any browser",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<BaseLayout
  title={`${tool.title} | Bitsmith`}
  description={tool.description}
  jsonLd={jsonLd}
>
  <nav class="mb-6 text-sm">
    <a href={href()} class="text-slate-600 underline dark:text-slate-400"
      >Home</a
    >
  </nav>

  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{tool.title}</h1>
  <p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
    {tool.tagline}
  </p>

  {
    tool.runsOn === "device" ? (
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-sm text-emerald-900 dark:bg-emerald-950 dark:text-emerald-200">
        This file stays on your device
      </p>
    ) : (
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">
        This tool sends your file to a server
      </p>
    )
  }

  <div class="mt-8">
    <ToolRunner client:load slug={tool.slug} />
  </div>

  <section class="mt-14 border-t border-slate-200 pt-8 dark:border-slate-800">
    <h2 class="text-xl font-bold">About this tool</h2>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
      {tool.description}
    </p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">Other tools</h2>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        related.map((other) => (
          <li>
            <a
              href={href(other.slug)}
              class="block rounded-lg border border-slate-200 p-4 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-900"
            >
              <span class="font-medium">{other.title}</span>
              <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">
                {other.tagline}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
