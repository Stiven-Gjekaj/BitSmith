---
import ToolIcon from "../components/ui/ToolIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/url";
import { pairs } from "../tools/image-convert/pairs";
import { tools } from "../tools/registry";

const title = "Bitsmith: small file tools that run in your browser";
const description =
  "Free tools for pictures, PDF files, and QR codes. Everything runs on " +
  "your own device. No upload, no account, no server.";

const facts = [
  ["No upload", "The file is read by your browser and never sent anywhere."],
  ["No account", "Nothing to sign up for, and nothing to sign in to."],
  ["Works offline", "Once a page has loaded, the work needs no connection."],
];
---

<BaseLayout title={title} description={description}>
  <section class="max-w-3xl py-12">
    <p class="tag rise" style="animation-delay:60ms">Five tools / zero uploads</p>

    <h1
      class="rise mt-4 text-4xl leading-[1.05] font-bold tracking-tighter sm:text-6xl"
      style="animation-delay:140ms"
    >
      <span class="tracked">Small file tools</span><br />
      that run in your browser
    </h1>

    <p
      class="rise mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground"
      style="animation-delay:220ms"
    >
      Drop a file, get it back changed. Your file never leaves your device,
      because there is no server to send it to.
    </p>

    <a
      href={href(tools[0].slug)}
      class="rise sweep relative mt-8 inline-flex h-12 items-center gap-2 overflow-hidden rounded-lg border border-border bg-card/70 px-6 font-medium text-foreground no-underline transition-all hover:-translate-y-0.5 hover:border-ring"
      style="animation-delay:300ms"
    >
      Start with a QR code
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </section>

  <section class="tools grid gap-3 sm:grid-cols-2" aria-label="The tools">
    {
      tools.map((tool, index) => (
        <a
          class="sweep group relative flex items-center gap-4 overflow-hidden rounded-lg border border-border bg-card/80 p-5 no-underline backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:border-ring rise"
          href={href(tool.slug)}
          style={`animation-delay:${380 + index * 80}ms`}
        >
          <span class="grid size-11 shrink-0 place-items-center rounded-md border border-border bg-primary/5 text-primary transition-colors group-hover:border-primary group-hover:bg-primary/15">
            <ToolIcon slug={tool.slug} />
          </span>
          <span class="flex min-w-0 flex-col gap-0.5">
            <span class="card-title font-semibold tracking-tight text-foreground">
              {tool.title}
            </span>
            <span class="text-sm text-muted-foreground">{tool.tagline}</span>
          </span>
          <span
            class="ml-auto shrink-0 text-muted-foreground opacity-0 transition-all group-hover:translate-x-0 group-hover:text-primary group-hover:opacity-100 -translate-x-1.5"
            aria-hidden="true"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </a>
      ))
    }
  </section>

  <section class="pairs rise mt-16" style="animation-delay:800ms">
    <h2 class="tag">Convert between two formats</h2>
    <p class="mt-2 text-sm text-muted-foreground">
      Each of these opens the converter already pointed the right way.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        pairs.map((pair) => (
          <li>
            <a
              href={href(pair.slug)}
              class="inline-block rounded-full border border-border bg-card/70 px-3.5 py-1.5 text-sm text-muted-foreground no-underline transition-all hover:-translate-y-px hover:border-primary hover:text-foreground"
            >
              {pair.fromLabel} <span aria-hidden="true">&rarr;</span>{" "}
              {pair.toLabel}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="rise mt-16 border-t border-border pt-9" style="animation-delay:900ms">
    <h2 class="tag">Why the browser does the work</h2>
    <div class="mt-6 grid gap-7 sm:grid-cols-3">
      {
        facts.map(([name, line]) => (
          <div>
            <h3 class="font-semibold tracking-tight">{name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
              {line}
            </p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
